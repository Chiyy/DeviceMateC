/* Windows 资源文件 - 嵌入应用图标和版本信息到 exe */

/* 应用图标 */
1 ICON "icon.ico"

/* 版本信息 (对应 versioninfo.json) */
1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK 0x3f
FILEFLAGS 0x0
FILEOS 0x40004
FILETYPE 0x1
FILESUBTYPE 0x0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404B0"
        BEGIN
            VALUE "CompanyName", "JHL"
            VALUE "FileDescription", "DeviceMate"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "DeviceMate"
            VALUE "LegalCopyright", "Copyright (c) 2026 huangcy@jihualab.ac.cn"
            VALUE "OriginalFilename", "DeviceMate.exe"
            VALUE "ProductName", "DeviceMate"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 0x04B0
    END
END
